# BlindReview MCP configuration. Copy to .env and fill in.
# Any OpenAI-compatible /chat/completions endpoint works.

# Base URL of the OpenAI-compatible API (without /chat/completions).
REVIEWER_BASE_URL=https://api.openai.com/v1
# API key for the reviewer provider. Leave empty for local servers that need none.
REVIEWER_API_KEY=
# Reviewer model id. Prefer a strong reasoning model from a DIFFERENT family than your main agent.
REVIEWER_MODEL=gpt-5-mini
# Optional: low | medium | high (sent as reasoning_effort; dropped automatically if the API rejects it).
REVIEWER_REASONING_EFFORT=
# Optional: how to send it. reasoning_effort (OpenAI/xAI style) or reasoning_object (OpenRouter style
# `reasoning: {effort}`). Auto-detected from REVIEWER_BASE_URL when empty.
REVIEWER_REASONING_PARAM=
# Max completion tokens per reviewer call.
REVIEWER_MAX_TOKENS=4000
# Hard cap on cumulative tokens (prompt + completion) across all phases of one review.
MAX_REVIEW_TOKENS=20000
# Reviewer has no tools in this MVP. Tool calls returned by the model are never executed;
# a response with more tool calls than this is rejected as malformed.
MAX_TOOL_CALLS=0
# Timeout for the whole review (all phases), in milliseconds.
REVIEW_TIMEOUT=120000
# Opt-in local telemetry (JSONL). No content is stored, only metadata.
TELEMETRY_ENABLED=false
TELEMETRY_PATH=./data/reviews.jsonl
